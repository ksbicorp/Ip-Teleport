{
  "manifest_version": 3,
  "name": "IP-TELEPORT // Cloudflare Origin Hunter",
  "version": "1.0.0",
  "description": "Instant IP resolver, Shodan intelligence analyzer, and automated Cloudflare origin IP discovery engine.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "IP-TELEPORT // Origin Hunter"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
